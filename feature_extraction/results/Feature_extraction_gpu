   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.ensemble import GradientBoostingClassifier\n",
    "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\n",
    "from sklearn.metrics import precision_score, recall_score, f1_score\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import os\n",
    "import time\n",
    "\n",
    "def load_handcrafted_features(data_path):\n",
    "    \"\"\"\n",
    "    Load and combine all handcrafted feature CSVs.\n",
    "    \n",
    "    Args:\n",
    "        data_path: Path to folder containing feature CSVs\n",
    "    \n",
    "    Returns:\n",
    "        Combined DataFrame with all handcrafted features\n",
    "    \"\"\"\n",
    "    print(f\"Loading handcrafted features from: {data_path}\")\n",
    "    \n",
    "    # Load each feature type\n",
    "    color_df = pd.read_csv(os.path.join(data_path, 'color_features.csv'))\n",
    "    edge_df = pd.read_csv(os.path.join(data_path, 'edge_structure_features.csv'))\n",
    "    shape_df = pd.read_csv(os.path.join(data_path, 'shape_features.csv'))\n",
    "    texture_df = pd.read_csv(os.path.join(data_path, 'texture_features.csv'))\n",
    "    \n",
    "    print(f\"  - Color features: {color_df.shape}\")\n",
    "    print(f\"  - Edge/Structure features: {edge_df.shape}\")\n",
    "    print(f\"  - Shape features: {shape_df.shape}\")\n",
    "    print(f\"  - Texture features: {texture_df.shape}\")\n",
    "    \n",
    "    # Extract labels (should be the same across all)\n",
    "    labels = color_df['label'].values\n",
    "    \n",
    "    # Drop label columns and combine features\n",
    "    color_features = color_df.drop('label', axis=1)\n",
    "    edge_features = edge_df.drop('label', axis=1)\n",
    "    shape_features = shape_df.drop('label', axis=1)\n",
    "    texture_features = texture_df.drop('label', axis=1)\n",
    "    \n",
    "    # Concatenate all features\n",
    "    combined_df = pd.concat([\n",
    "        color_features,\n",
    "        edge_features,\n",
    "        shape_features,\n",
    "        texture_features\n",
    "    ], axis=1)\n",
    "    \n",
    "    # Add labels back\n",
    "    combined_df['label'] = labels\n",
    "    \n",
    "    print(f\"\\nCombined handcrafted features: {combined_df.shape}\")\n",
    "    print(f\"Total features: {combined_df.shape[1] - 1}\")\n",
    "    \n",
    "    return combined_df\n",
    "\n",
    "def load_learned_features(data_path):\n",
    "    \"\"\"\n",
    "    Load learned features CSV.\n",
    "    \n",
    "    Args:\n",
    "        data_path: Path to folder containing learned_features.csv\n",
    "    \n",
    "    Returns:\n",
    "        DataFrame with learned features\n",
    "    \"\"\"\n",
    "    print(f\"Loading learned features from: {data_path}\")\n",
    "    \n",
    "    learned_df = pd.read_csv(os.path.join(data_path, 'learned_features.csv'))\n",
    "    \n",
    "    print(f\"  - Learned features: {learned_df.shape}\")\n",
    "    print(f\"Total features: {learned_df.shape[1] - 1}\")\n",
    "    \n",
    "    return learned_df\n",
    "\n",
    "def train_bdt_model(X_train, y_train, model_name=\"BDT\", n_estimators=100, learning_rate=0.1, max_depth=5):\n",
    "    \"\"\"\n",
    "    Train a Gradient Boosting Decision Tree (BDT) model.\n",
    "    \n",
    "    Args:\n",
    "        X_train: Training features\n",
    "        y_train: Training labels\n",
    "        model_name: Name for logging\n",
    "        n_estimators: Number of boosting stages\n",
    "        learning_rate: Learning rate\n",
    "        max_depth: Maximum depth of trees\n",
    "    \n",
    "    Returns:\n",
    "        Trained model\n",
    "    \"\"\"\n",
    "    print(f\"\\n{'='*70}\")\n",
    "    print(f\"Training {model_name}\")\n",
    "    print(f\"{'='*70}\")\n",
    "    print(f\"Training samples: {X_train.shape[0]}\")\n",
    "    print(f\"Number of features: {X_train.shape[1]}\")\n",
    "    print(f\"Number of classes: {len(np.unique(y_train))}\")\n",
    "    print(f\"\\nModel parameters:\")\n",
    "    print(f\"  - n_estimators: {n_estimators}\")\n",
    "    print(f\"  - learning_rate: {learning_rate}\")\n",
    "    print(f\"  - max_depth: {max_depth}\")\n",
    "    \n",
    "    # Initialize model\n",
    "    model = GradientBoostingClassifier(\n",
    "        n_estimators=n_estimators,\n",
    "        learning_rate=learning_rate,\n",
    "        max_depth=max_depth,\n",
    "        random_state=42,\n",
    "        verbose=1\n",
    "    )\n",
    "    \n",
    "    # Train model\n",
    "    print(\"\\nTraining...\")\n",
    "    start_time = time.time()\n",
    "    model.fit(X_train, y_train)\n",
    "    training_time = time.time() - start_time\n",
    "    \n",
    "    print(f\"\\n✓ Training complete in {training_time:.2f} seconds\")\n",
    "    \n",
    "    return model, training_time\n",
    "\n",
    "def evaluate_model(model, X_test, y_test, model_name=\"Model\"):\n",
    "    \"\"\"\n",
    "    Evaluate model performance on test set.\n",
    "    \n",
    "    Args:\n",
    "        model: Trained model\n",
    "        X_test: Test features\n",
    "        y_test: Test labels\n",
    "        model_name: Name for logging\n",
    "    \n",
    "    Returns:\n",
    "        Dictionary with evaluation metrics\n",
    "    \"\"\"\n",
    "    print(f\"\\n{'='*70}\")\n",
    "    print(f\"Evaluating {model_name}\")\n",
    "    print(f\"{'='*70}\")\n",
    "    \n",
    "    # Make predictions\n",
    "    start_time = time.time()\n",
    "    y_pred = model.predict(X_test)\n",
    "    inference_time = time.time() - start_time\n",
    "    \n",
    "    # Calculate metrics\n",
    "    accuracy = accuracy_score(y_test, y_pred)\n",
    "    precision = precision_score(y_test, y_pred, average='weighted', zero_division=0)\n",
    "    recall = recall_score(y_test, y_pred, average='weighted', zero_division=0)\n",
    "    f1 = f1_score(y_test, y_pred, average='weighted', zero_division=0)\n",
    "    \n",
    "    print(f\"\\nTest samples: {X_test.shape[0]}\")\n",
    "    print(f\"Inference time: {inference_time:.2f} seconds\")\n",
    "    print(f\"Time per sample: {(inference_time/X_test.shape[0])*1000:.2f} ms\")\n",
    "    \n",
    "    print(f\"\\n{'='*40}\")\n",
    "    print(f\"PERFORMANCE METRICS\")\n",
    "    print(f\"{'='*40}\")\n",
    "    print(f\"Accuracy:  {accuracy:.4f} ({accuracy*100:.2f}%)\")\n",
    "    print(f\"Precision: {precision:.4f}\")\n",
    "    print(f\"Recall:    {recall:.4f}\")\n",
    "    print(f\"F1-Score:  {f1:.4f}\")\n",
    "    \n",
    "    # Detailed classification report\n",
    "    print(f\"\\n{'='*40}\")\n",
    "    print(\"Per-Class Performance:\")\n",
    "    print(f\"{'='*40}\")\n",
    "    print(classification_report(y_test, y_pred, zero_division=0))\n",
    "    \n",
    "    # Store metrics\n",
    "    metrics = {\n",
    "        'accuracy': accuracy,\n",
    "        'precision': precision,\n",
    "        'recall': recall,\n",
    "        'f1': f1,\n",
    "        'inference_time': inference_time,\n",
    "        'predictions': y_pred\n",
    "    }\n",
    "    \n",
    "    return metrics\n",
    "\n",
    "def plot_confusion_matrix(y_test, y_pred, model_name, save_path):\n",
    "    \"\"\"\n",
    "    Plot confusion matrix.\n",
    "    \"\"\"\n",
    "    cm = confusion_matrix(y_test, y_pred)\n",
    "    \n",
    "    plt.figure(figsize=(12, 10))\n",
    "    sns.heatmap(cm, annot=False, fmt='d', cmap='Blues', cbar=True)\n",
    "    plt.title(f'Confusion Matrix - {model_name}', fontsize=16, fontweight='bold')\n",
    "    plt.xlabel('Predicted Label', fontsize=12)\n",
    "    plt.ylabel('True Label', fontsize=12)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(save_path, dpi=150, bbox_inches='tight')\n",
    "    plt.close()\n",
    "    print(f\"✓ Confusion matrix saved to: {save_path}\")\n",
    "\n",
    "def plot_comparison(handcrafted_metrics, learned_metrics, save_path):\n",
    "    \"\"\"\n",
    "    Plot comparison between handcrafted and learned features.\n",
    "    \"\"\"\n",
    "    metrics_names = ['Accuracy', 'Precision', 'Recall', 'F1-Score']\n",
    "    handcrafted_values = [\n",
